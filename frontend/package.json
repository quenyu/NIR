{
  "name": "nir-dynamics-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:diagnostics": "node tests/unit/run-diagnostics-tests.mjs",
    "test:layout": "node tests/unit/run-layout-tests.mjs",
    "test:persistence": "node tests/unit/run-persistence-tests.mjs",
    "lint": "eslint src --max-warnings 0",
    "test:unit": "npm run -s test:diagnostics && npm run -s test:layout && npm run -s test:persistence",
    "check": "tsc -b && npm run -s lint && npm run -s test:unit"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "cmdk": "^1.0.4",
    "elkjs": "^0.11.1",
    "plotly.js": "^2.35.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-plotly.js": "^2.6.0",
    "reactflow": "^11.11.4",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.52.0",
    "@types/plotly.js": "^2.12.39",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^5.4.1"
  }
}
