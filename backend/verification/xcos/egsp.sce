// ЭГСП 8-го порядка (пример 3.3 записки КП) в Xcos. Параметры — задания к практическим занятиям 01–02
// по дисциплине «Исполнительные устройства систем управления»,
// E = 1e7 Па. Золотник и поршень (m·d²x/dt² + h·dx/dt + c·x = F·p) собраны из двух интеграторов
// «ускорение → скорость → положение»; скорость снимается с первого интегратора для связей F_з·dx/dt и F·dY/dt.
exec("xcos_lib.sci", -1); loadXcosLibs(); loadScicos();
scs_m = scicos_diagram(); Y0 = 200;
[scs_m, U]    = add_block(scs_m, "CONST_m", "0.01", 0, Y0, "U = 0,01 В");
[scs_m, err]  = add_block(scs_m, "SUMMATION", ["1"; "[1;-1]"; "0"], 90, Y0, "");
[scs_m, amp]  = add_block(scs_m, "GAINBLK", ["50"; "0"], 150, Y0, "kус");
[scs_m, coil] = add_block(scs_m, "CLR", ["1"; "80+0.4*s"], 240, Y0, "обмотка ЭМП");
[scs_m, trq]  = add_block(scs_m, "SUMMATION", ["1"; "[-1;1]"; "0"], 340, Y0, "");
[scs_m, arm]  = add_block(scs_m, "CLR", ["1"; "0.1+7e-5*s+0.3e-6*s^2"], 400, Y0, "якорь ЭМП");
[scs_m, flap] = add_block(scs_m, "GAINBLK", ["1e-3"; "0"], 500, Y0, "kQφ");
[scs_m, flow] = add_block(scs_m, "SUMMATION", ["1"; "[1;-1]"; "0"], 590, Y0, "");
[scs_m, prs]  = add_block(scs_m, "GAINBLK", ["1e6"; "0"], 650, Y0, "1/kQp");
[scs_m, sf]   = add_block(scs_m, "GAINBLK", ["0.785e-4"; "0"], 740, Y0, "Fз");
[scs_m, sb]   = add_block(scs_m, "SUMMATION", ["1"; "[-1;1;-1]"; "0"], 830, Y0, "");
[scs_m, sm]   = add_block(scs_m, "GAINBLK", ["1/0.005"; "0"], 890, Y0, "1/mз");
[scs_m, sv]   = add_block(scs_m, "INTEGRAL_m", ["0"; "0"; "0"; "1"; "-1"], 980, Y0, "dx/dt");
[scs_m, sx]   = add_block(scs_m, "INTEGRAL_m", ["0"; "0"; "0"; "1"; "-1"], 1080, Y0, "x");
[scs_m, ssp]  = add_block(scs_m, "GAINBLK", ["2"; "0"], 930, 110, "2Cгд", %t);
[scs_m, mfb]  = add_block(scs_m, "GAINBLK", ["10"; "0"], 600, 40, "kмос", %t);
[scs_m, sfr]  = add_block(scs_m, "GAINBLK", ["0.25"; "0"], 930, 280, "hз", %t);
[scs_m, sar]  = add_block(scs_m, "GAINBLK", ["0.785e-4"; "0"], 760, 350, "Fз", %t);
[scs_m, vlv]  = add_block(scs_m, "GAINBLK", ["4.3"; "0"], 1200, Y0, "kQx");
[scs_m, cfl]  = add_block(scs_m, "SUMMATION", ["1"; "[1;-1]"; "0"], 1290, Y0, "");
[scs_m, cyl]  = add_block(scs_m, "CLR", ["1"; "1e-10+(647e-6/(2*1e7))*s"], 1350, Y0, "полости ГЦ");
[scs_m, pf]   = add_block(scs_m, "GAINBLK", ["1.99e-3"; "0"], 1450, Y0, "F");
[scs_m, pb]   = add_block(scs_m, "SUMMATION", ["1"; "[1;-1]"; "0"], 1540, Y0, "");
[scs_m, pm]   = add_block(scs_m, "GAINBLK", ["1/10"; "0"], 1600, Y0, "1/M");
[scs_m, pv]   = add_block(scs_m, "INTEGRAL_m", ["0"; "0"; "0"; "1"; "-1"], 1690, Y0, "dY/dt");
[scs_m, py]   = add_block(scs_m, "INTEGRAL_m", ["0"; "0"; "0"; "1"; "-1"], 1790, Y0, "Y");
[scs_m, pfr]  = add_block(scs_m, "GAINBLK", ["10"; "0"], 1640, 280, "h", %t);
[scs_m, par]  = add_block(scs_m, "GAINBLK", ["1.99e-3"; "0"], 1420, 350, "F", %t);
[scs_m, sen]  = add_block(scs_m, "GAINBLK", ["0.1"; "0"], 900, 430, "kос", %t);
[scs_m, sc, tw] = add_scope(scs_m, 1960, Y0, 0.0005, 0.7, 0, 0.12);
scs_m = connect(scs_m, U, 1, err, 1);
scs_m = connect(scs_m, err, 1, amp, 1);
scs_m = connect(scs_m, amp, 1, coil, 1);
scs_m = connect(scs_m, coil, 1, trq, 2);
scs_m = connect(scs_m, trq, 1, arm, 1);
scs_m = connect(scs_m, arm, 1, flap, 1);
scs_m = connect(scs_m, flap, 1, flow, 1);
scs_m = connect(scs_m, flow, 1, prs, 1);
scs_m = connect(scs_m, prs, 1, sf, 1);
scs_m = connect(scs_m, sf, 1, sb, 2);
scs_m = connect(scs_m, sb, 1, sm, 1);
scs_m = connect(scs_m, sm, 1, sv, 1);
scs_m = fan(scs_m, sv, 1, [sx 1; sfr 1; sar 1], list(zeros(0, 2), [1060 220; 1060 300], [1068 220; 1068 370]));
scs_m = fan(scs_m, sx, 1, [vlv 1; ssp 1; mfb 1], list(zeros(0, 2), [1160 220; 1160 130], [1168 220; 1168 60]));
scs_m = connect(scs_m, ssp, 1, sb, 1, [815 130; 815 210]);
scs_m = connect(scs_m, sfr, 1, sb, 3, [815 300; 815 230]);
scs_m = connect(scs_m, sar, 1, flow, 2, [575 370; 575 226.7]);
scs_m = connect(scs_m, mfb, 1, trq, 1, [325 60; 325 213.3]);
scs_m = connect(scs_m, vlv, 1, cfl, 1);
scs_m = connect(scs_m, cfl, 1, cyl, 1);
scs_m = connect(scs_m, cyl, 1, pf, 1);
scs_m = connect(scs_m, pf, 1, pb, 1);
scs_m = connect(scs_m, pb, 1, pm, 1);
scs_m = connect(scs_m, pm, 1, pv, 1);
scs_m = fan(scs_m, pv, 1, [py 1; pfr 1; par 1], list(zeros(0, 2), [1770 220; 1770 300], [1778 220; 1778 370]));
scs_m = connect(scs_m, pfr, 1, pb, 2, [1525 300; 1525 226.7]);
scs_m = connect(scs_m, par, 1, cfl, 2, [1275 370; 1275 226.7]);
scs_m = fan(scs_m, py, 1, [sc 1; tw 1; sen 1], list(zeros(0, 2), [1880 220; 1880 350], [1890 220; 1890 450]));
scs_m = connect(scs_m, sen, 1, err, 2, [75 450; 75 226.7]);
run_diagram(scs_m, "egsp", 0.7);
